datasets/sources/**/*.csv filter=lfs diff=lfs merge=lfs -text
# Only the plain .csv goes to LFS: the .csv.gz siblings are byte-identical
# content in another form, and tracking both doubled the storage for nothing.
datasets/raw_tables/**/*.csv filter=lfs diff=lfs merge=lfs -text

# Never let `git archive` emit LFS pointer stubs into a depositor.
#
# Measured, not assumed: the v1.0.0 Zenodo payload was 152,429 bytes and its
# creditcard.csv member was a 134-byte pointer, because archive expansion
# depends on the local LFS filter configuration. A deposit built that way looks
# complete and is silently empty. Marking these paths export-ignore removes the
# dependency on local LFS state entirely: such an archive simply does not claim
# to carry data, and DATA_SOURCES.md says where the data really lives.
datasets/sources export-ignore
datasets/raw_tables export-ignore
